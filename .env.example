# Осы файлды көшіріп, атын .env деп өзгерт. .env файлын ешқашан GitHub-қа салма!

# --- Қай жол арқылы: meta (тікелей Meta, тест нөмірі) немесе ycloud (YCloud серіктесі, Coexistence) ---
PROVIDER=meta

# --- YCloud (PROVIDER=ycloud болса) ---
# YCloud → Developers бөлімі → API key
YCLOUD_API_KEY=
# YCloud → Developers → Webhook → endpoint қосқанда берілетін secret
YCLOUD_WEBHOOK_SECRET=
# Клиенттің өз YCloud аккаунты болса (README: "Жаңа клиент"), атауымен қос, мысалы салон "Ару":
# YCLOUD_API_KEY_ARU=
# YCLOUD_WEBHOOK_SECRET_ARU=
# және businesses/aru-salon/config.yaml ішінде: ycloud_account: aru
# Бизнес иесі телефоннан клиентке өзі жазса, бот сол чатта неше сағат үндемейді
OWNER_PAUSE_HOURS=6

# --- Meta / WhatsApp (PROVIDER=meta болса) ---
# Өзің ойлап тапқан кез келген құпия сөз. Meta-да webhook баптағанда да осыны жазасың.
WHATSAPP_VERIFY_TOKEN=ozim-oilap-tapqan-soz-123
# Meta App → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
# WhatsApp → API Setup → Temporary access token (24 сағат жарамды; кейін тұрақты токен)
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0
# Тест нөмірі біреу болса, барлық хабарламаға осы бизнес жауап береді
DEFAULT_BUSINESS_ID=zhas-bot

# --- AI (тек mode: ai бизнестер үшін; базалық бот (mode: menu) кілтсіз жұмыс істейді) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# multilingual-e5-small үшін 0.24 (нақты тексеру бойынша): дұрыс сұрақтардың ең алысы 0.221 (орысша),
# мүлде тыс сұрақтар (парковка 0.247, валюта 0.267) тоқтатылады. Аралықтағысын промпт ережесі ұстайды.
# Орысша сұрақтар үшін knowledge.txt соңына қысқа орысша бөлім қосқан дұрыс. run_eval --retrieval-only арқылы тексер.
MAX_DISTANCE=0.24

# --- Telegram: өтінімдер ("жазылғым келеді") мен "адам керек" хабарлары ---
# @BotFather → /newbot → берілген токен. Нұсқаулық README-де.
TELEGRAM_BOT_TOKEN=
# Ортақ чат (бизнестің config.yaml ішінде өз telegram_chat_id-і болмаса осында барады)
TELEGRAM_CHAT_ID=
